                      .${endColour}\n"

    for i in $(seq 1 80); do echo -ne "${redColour}-"; done; echo -ne "${endColour}"
}

# ---------- helpers ----------

# Tabla con bordes. stdin = TSV, 1ª línea = cabecera
function printTable(){
    awk -F'\t' '
    { rows[NR]=$0; n=split($0,f,"\t"); if(n>nc)nc=n; for(i=1;i<=n;i++){ l=length(f[i]); if(l>w[i])w[i]=l } }
    END{
        if(NR==0) exit
        sep="+"; for(i=1;i<=nc;i++){ s=""; for(j=0;j<w[i]+2;j++) s=s"-"; sep=sep s "+" }
        print sep
        for(r=1;r<=NR;r++){
            n=split(rows[r],f,"\t"); line="|"
            for(i=1;i<=nc;i++) line=line sprintf(" %-*s |", w[i], f[i])
            print line
            if(r==1) print sep
        }
        print sep
    }'
}

function urlenc(){ jq -rn --arg s "$1" '$s|@uri'; }

# api METHOD PATH [JSON]  -> cuerpo en $RESP, status en $HTTP_CODE (llamar SIN $(...))
function api(){
    local method=$1 path=$2 data=${3:-}
    local args=(-sS -o "$RESP" -w '%{http_code}' -X "$method"
                -H "Authorization: Bearer $API_TOKEN" -H "Accept: application/json" -H "User-Agent: $USER_AGENT")
    [[ -n $data ]] && args+=(-H "Content-Type: application/json" -d "$data")
    HTTP_CODE=$(curl "${args[@]}" "$API_URL$path" 2>"$TMP/err") || die "curl: $(cat "$TMP/err")"
}

function apiMsg(){ jq -r '.message // .error // empty' "$RESP" 2>/dev/null; }

# 0 si 2xx; aborta en errores globales; 1 en el resto (el caller decide)
function checkHTTP(){
    case $HTTP_CODE in
        2??) return 0;;
        401) die "401: token inválido o caducado. Genera un App Token nuevo en app.hackthebox.com/profile/settings";;
        403) die "403: acceso denegado (permisos o WAF/Cloudflare). $(apiMsg)";;
        429) die "429: rate limit. Espera unos segundos y reintenta.";;
    esac
    return 1
}

function resolveMachine(){
    api GET "/machine/profile/$(urlenc "$1")"
    if ! checkHTTP; then
        [[ $HTTP_CODE == 404 ]] && die "No existe ninguna máquina llamada '$1'"
        die "HTTP $HTTP_CODE resolviendo '$1': $(apiMsg)"
    fi
    MID=$(jq -r '.info.id // empty' "$RESP"); MNAME=$(jq -r '.info.name // empty' "$RESP")
    [[ -n $MID ]] || die "Respuesta inesperada de /machine/profile/$1"
}

# ---------- listado de máquinas ----------

JQ_DEFS='def osk: (.os // "" | ascii_downcase);
def owned: [ (if .authUserInUserOwns then "user" else empty end), (if .authUserInRootOwns then "root" else empty end) ] | join("+") | if . == "" then "-" else . end;'
JQ_ROW='[ .name, (.os // "-"), (.difficultyText // "-"), (.points // "-"), (.stars // "-"), (.user_owns_count // "-"), (.root_owns_count // "-"), .retired, ((.release // "-") | tostring | .[0:10]), (if .free then "Yes" else "No" end), owned, .id ] | map(tostring) | @tsv'
OS_OTHER='(osk as $o | ["linux","windows","freebsd","openbsd"] | index($o)) == null'
MACHINES_HEADER=$'Name\tOS\tDifficulty\tPoints\tRating\tUser Owns\tRoot Owns\tRetired\tRelease\tFree\tOwned\tID'

# fetchSet active|retired -> $TMP/<set>.json (array con campo extra "retired")
function fetchSet(){
    local ep label page=1 last out="$TMP/$1.json"
    if [[ $1 == active ]]; then ep="/machine/paginated"; label="No"; else ep="/machine/list/retired/paginated"; label="Yes"; fi
    echo '[]' > "$out"
    while :; do
        api GET "$ep?per_page=100&page=$page"
        checkHTTP || die "HTTP $HTTP_CODE en $ep: $(apiMsg)"
        jq -e '.data | type == "array"' "$RESP" >/dev/null 2>&1 || die "Respuesta inesperada de $ep (¿cambió la API?)"
        jq -s --arg r "$label" '.[0] + (.[1].data | map(. + {retired:$r}))' "$out" "$RESP" > "$out.n" && mv "$out.n" "$out"
        last=$(jq -r '.meta.last_page // 1' "$RESP")
        (( page >= last )) && break
        ((page++))
    done
}

# machinesTable "<filtro jq>" set...
function machinesTable(){
    local filt=$1; shift
    local s files=()
    for s in "$@"; do fetchSet "$s"; files+=("$TMP/$s.json"); done
    jq -s 'add' "${files[@]}" > "$TMP/all.json"
    local rows
    rows=$(jq -r "$JQ_DEFS map(select($filt)) | .[] | $JQ_ROW" "$TMP/all.json")
    if [[ -z $rows ]]; then echo -e "\n${redColour}[!] Sin resultados${endColour}\n"; return 1; fi
    echo -ne "${greenColour}"
    { echo "$MACHINES_HEADER"; echo "$rows"; } | printTable
    echo -e "${endColour}"
}

function exploreMode(){
    local mode=$1 scope os filt='true' own='(.authUserInUserOwns == true or .authUserInRootOwns == true)'
    case $mode in
        all_machines)           machinesTable "$filt" active retired;;
        active_machines)        machinesTable "$filt" active;;
        retired_machines)       machinesTable "$filt" retired;;
        owned_machines)         machinesTable "$own" active retired;;
        owned_active_machines)  machinesTable "$own" active;;
        spawned_machines)       spawnedMachines;;
        active_*_machines|retired_*_machines)
            scope=${mode%%_*}; os=${mode#*_}; os=${os%_machines}
            case $os in
                linux|windows|freebsd|openbsd) filt="osk == \"$os\"";;
                other) filt="$OS_OTHER";;
                *) helpPanel;;
            esac
            machinesTable "$filt" "$scope";;
        *) helpPanel;;
    esac
}

function spawnedMachines(){
    api GET /machine/active; checkHTTP || die "HTTP $HTTP_CODE: $(apiMsg)"
    if [[ -z $(jq -r '.info.id // empty' "$RESP") ]]; then
        echo -e "\n${redColour}[!] No tienes ninguna máquina activa${endColour}\n"; return 1
    fi
    echo -ne "${greenColour}"
    { printf 'Name\tID\tIP\tType\tExpires\tSpawning\n'
      jq -r '.info | [(.name//"-"),(.id//"-"),(.ip//"-"),(.type//"-"),(.expires_at//"-"),((.isSpawning//false)|tostring)] | map(tostring) | @tsv' "$RESP"; } | printTable
    echo -e "${endColour}"
}

function searchMachineName(){
    export KW="$1"
    machinesTable '(.name // "" | ascii_downcase | contains(($ENV.KW) | ascii_downcase))' active retired \
        || exit 1
}

# La API v4 solo expone la IP de la máquina que tienes activa
function searchIPAddress(){
    api GET /machine/active; checkHTTP || die "HTTP $HTTP_CODE: $(apiMsg)"
    if [[ "$(jq -r '.info.ip // empty' "$RESP")" == "$1" ]]; then spawnedMachines
    else die "Esa IP no corresponde a tu máquina activa (la API v4 no expone IPs de máquinas no spawneadas)"; fi
}

# ---------- usuarios ----------

function searchUserName(){
    local uid
    api GET "/search/fetch?query=$(urlenc "$1")"; checkHTTP || die "HTTP $HTTP_CODE: $(apiMsg)"
    uid=$(jq -r --arg u "$1" '(.users // []) as $l | ([$l[] | select(((.value // .name // "") | ascii_downcase) == ($u | ascii_downcase))] + $l) | .[0].id // empty' "$RESP")
    [[ -n $uid ]] || die "No existe ningún usuario que coincida con '$1'"
    api GET "/user/profile/basic/$uid"; checkHTTP || die "HTTP $HTTP_CODE: $(apiMsg)"
    echo -ne "${yellowColour}"
    { printf 'Username\tID\tRank\tRanking\tPoints\tUser Owns\tSystem Owns\tRespects\tCountry\n'
      jq -r '.profile | [(.name//"-"),(.id//"-"),(.rank//"-"),(.ranking//"-"),(.points//"-"),(.user_owns//"-"),(.system_owns//"-"),(.respects//"-"),(.country_name//"-")] | map(tostring) | @tsv' "$RESP"; } | printTable
    echo -e "${endColour}"
}

# ---------- acciones sobre máquinas ----------

function machineAction(){ # spawn|terminate|reset|extend NAME
    resolveMachine "$2"
    api POST "/vm/$1" "{\"machine_id\":$MID}"
    if checkHTTP; then ok "$MNAME: $(apiMsg)"
    else die "$1 falló (HTTP $HTTP_CODE): $(apiMsg)"; fi
}

function sendFlags(){
    [[ $1 == *=* ]] || helpPanel
    local name=${1%%=*} flag=${1#*=}
    resolveMachine "$name"
    api POST /machine/own "$(jq -nc --arg f "$flag" --argjson id "$MID" '{flag:$f,id:$id}')"
    if checkHTTP; then echo -e "${greenColour}[+] $MNAME: $(apiMsg)${endColour}"
    else echo -e "${redColour}[!] $MNAME: $(apiMsg) (HTTP $HTTP_CODE)${endColour}"; exit 1; fi
}

# ---------- VPN ----------

function downloadVPN(){
    local out=$1 id=${HTB_VPN_ID:-} tcp=${HTB_VPN_TCP:-0}
    if [[ -z $id ]]; then
        api GET "/connections/servers?product=labs"; checkHTTP || die "HTTP $HTTP_CODE: $(apiMsg)"
        id=$(jq -r '.data.assigned.id // empty' "$RESP")
        if [[ -z $id ]]; then
            echo -e "\n${yellowColour}[*] Servidores disponibles (ID, nombre):${endColour}"
            jq -r '[.. | objects | select(has("friendly_name") and has("id"))] | unique_by(.id) | .[] | "\(.id)\t\(.friendly_name)"' "$RESP"
            die "No tienes servidor asignado. Exporta HTB_VPN_ID=<id> (y HTB_VPN_TCP=1 si quieres TCP)"
        fi
    fi
    api GET "/access/ovpnfile/$id/$tcp"; checkHTTP || die "HTTP $HTTP_CODE descargando VPN: $(apiMsg)"
    grep -q '^remote ' "$RESP" || die "La respuesta no parece un .ovpn válido"
    mv "$RESP" "$out" && chmod 600 "$out"
    ok "VPN guardada en $out (servidor $id, $([[ $tcp == 1 ]] && echo tcp || echo udp))"
}

