# ---------- main ----------

missing=(); for p in curl jq awk; do command -v "$p" >/dev/null 2>&1 || missing+=("$p"); done
(( ${#missing[@]} )) && die "Faltan dependencias: ${missing[*]}  (pacman -S ${missing[*]} | apt install ${missing[*]})"

parameter_counter=0
while getopts ":e:s:i:u:r:c:w:d:k:x:a:v:f:h" arg; do
    case $arg in
        e) explorer_mode=$OPTARG;;
        s) search_machine_name=$OPTARG;;
        i) ip_address=$OPTARG;;
        u) user_name=$OPTARG;;
        r) reset_machineName=$OPTARG;;
        d) machine_to_deploy=$OPTARG;;
        k) machine_to_stop=$OPTARG;;
        x) machine_to_extend=$OPTARG;;
        f) send_flag=$OPTARG;;
        v) download_vpn=$OPTARG;;
        a) removed="-a (assign) ya no existe: usa -d para spawnear";;
        c|w) removed="-$arg (shoutbox) fue eliminado de la plataforma";;
        h|\?|:) helpPanel;;
    esac
    let parameter_counter+=1
done
(( parameter_counter == 0 )) && helpPanel
[[ -n $removed ]] && die "$removed"

[[ -z $API_TOKEN && -r $TOKEN_FILE ]] && API_TOKEN=$(<"$TOKEN_FILE")
API_TOKEN=${API_TOKEN//[$'\r\n ']/}
[[ -n $API_TOKEN ]] || die "Falta el App Token. Créalo en app.hackthebox.com/profile/settings y haz: export HTB_TOKEN='...'"

[[ -n $search_machine_name ]] && { searchMachineName "$search_machine_name"; exit 0; }
[[ -n $ip_address ]]          && { searchIPAddress "$ip_address"; exit 0; }
[[ -n $user_name ]]           && { searchUserName "$user_name"; exit 0; }
[[ -n $reset_machineName ]]   && { machineAction reset "$reset_machineName"; exit 0; }
[[ -n $machine_to_deploy ]]   && { machineAction spawn "$machine_to_deploy"; exit 0; }
[[ -n $machine_to_stop ]]     && { machineAction terminate "$machine_to_stop"; exit 0; }
[[ -n $machine_to_extend ]]   && { machineAction extend "$machine_to_extend"; exit 0; }
[[ -n $send_flag ]]           && { sendFlags "$send_flag"; exit 0; }
[[ -n $download_vpn ]]        && { downloadVPN "$download_vpn"; exit 0; }
[[ -n $explorer_mode ]]       && { exploreMode "$explorer_mode"; exit 0; }
helpPanel
