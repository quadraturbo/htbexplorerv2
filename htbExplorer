#!/usr/bin/env bash

# htbExplorer v2 - cliente de terminal para HackTheBox Labs (API v4)
# Autor original: Marcelo Vázquez (aka S4vitar)
# Port a labs.hackthebox.com/api/v4: Bearer App Token, sin html2text, sin python, sin root.
#
# Token: App Token de https://app.hackthebox.com/profile/settings  (sección "App Tokens")
#   export HTB_TOKEN="eyJ0..."   |   ~/.config/htbExplorer/token   |   variable API_TOKEN de abajo

#Colours
declare -r greenColour="\e[0;32m\033[1m"
declare -r endColour="\033[0m\e[0m"
declare -r redColour="\e[0;31m\033[1m"
declare -r blueColour="\e[0;34m\033[1m"
declare -r yellowColour="\e[0;33m\033[1m"
declare -r purpleColour="\e[0;35m\033[1m"
declare -r turquoiseColour="\e[0;36m\033[1m"
declare -r grayColour="\e[0;37m\033[1m"

# Global Variables
declare -r API_URL="${HTB_API_URL:-https://labs.hackthebox.com/api/v4}"
declare -r USER_AGENT="Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"
declare -r TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/htbExplorer/token"
API_TOKEN="${HTB_TOKEN:-}"   # <- o pega aquí tu App Token

TMP="$(mktemp -d)"; RESP="$TMP/resp"; HTTP_CODE=0; MID=""; MNAME=""

cleanup(){ rm -rf "$TMP" 2>/dev/null; tput cnorm 2>/dev/null; }
trap cleanup EXIT
trap 'echo -e "\n\n${redColour}[!] Exiting...${endColour}"; exit 130' INT

die(){  echo -e "\n${redColour}[!] $*${endColour}\n" >&2; exit 1; }
ok(){   echo -e "\n${greenColour}[+]${endColour}${grayColour} $*${endColour}\n"; }
info(){ echo -e "\n${yellowColour}[*]${endColour}${grayColour} $*${endColour}\n"; }

